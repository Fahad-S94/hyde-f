# Include dynamic wallbash theme (loaded after main config so you can override anything)
config-file = ~/.config/ghostty/theme.conf

# Font
font-family = "CaskaydiaCove Nerd Font Mono"
font-size = 14
font-style-bold = Bold
font-style-bold-italic = Bold Italic
font-style-italic = Italic

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-decoration = false
window-padding-x = 5
window-padding-y = 5

# Scrolling & Selection
scrollback-lines = 10000
scroll-multiplier = 6
selection-copy-on-select = true

# Keybindings (explicit for consistency)
keybind = ctrl+shift+c=copy
keybind = ctrl+shift+v=paste
keybind = ctrl+alt+backspace=delete_word_backward:text:\x15

# Recommended Ghostty improvements (remove any you don't like)
background-opacity = 0.9                  # transparency (uncommented now that theme controls bg)
minimum-contrast = 4.5
font-ligatures = true
shell-integration = auto
cursor-hide-while-typing = true
font-thicken = true
